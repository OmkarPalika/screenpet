{
  "name": "screenpet",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop pet that answers what is on your screen. Fully offline.",
  "author": "Omkar Palika",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmkarPalika/screenpet.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "verify:ui": "electron test/verify-ui.js",
    "smoke": "set SCREENPET_SMOKE=1&& electron .",
    "demo": "electron demo/record.js",
    "license": "node build/license.js",
    "dist": "npm run license && electron-builder",
    "release": "npm run license && electron-builder --publish always",
    "pack": "npm run license && electron-builder --dir",
    "doctor": "node test/doctor.js",
    "build:helper": "swiftc -O -o src/system/mac/screenpet-helper src/system/mac/screenpet-helper.swift -framework Vision -framework CryptoKit -framework Security"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "gifenc": "^1.0.3"
  },
  "build": {
    "appId": "dev.screenpet.app",
    "productName": "screenpet",
    "publish": [
      {
        "provider": "github",
        "owner": "OmkarPalika",
        "repo": "screenpet"
      }
    ],
    "asarUnpack": [
      "src/system/*.ps1",
      "src/system/mac/*"
    ],
    "files": [
      "src/**",
      "assets/icon.png"
    ],
    "extraFiles": [
      "LICENSE",
      "TERMS.md",
      "PRIVACY.md",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "license": "build/license.txt",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "screenpet",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "electron@43.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
