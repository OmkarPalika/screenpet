{
  "name": "screenpet",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop pet that answers what is on your screen. Fully offline.",
  "author": "Omkar Palika",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "verify:ui": "electron test/verify-ui.js",
    "smoke": "set SCREENPET_SMOKE=1&& electron .",
    "demo": "electron demo/record.js",
    "license": "node build/license.js",
    "dist": "npm run license && electron-builder",
    "pack": "npm run license && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "gifenc": "^1.0.3"
  },
  "build": {
    "appId": "dev.screenpet.app",
    "productName": "screenpet",
    "asarUnpack": [
      "src/system/*.ps1"
    ],
    "files": [
      "src/**",
      "assets/icon.png"
    ],
    "extraFiles": [
      "LICENSE",
      "TERMS.md",
      "PRIVACY.md",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "license": "build/license.txt",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "screenpet",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
